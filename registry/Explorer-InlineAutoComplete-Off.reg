Windows Registry Editor Version 5.00

; Explorer address bar / Run dialog: do not complete paths inline while typing
; (same as the inetcpl.cpl option "Use inline AutoComplete...").
; Undo: set "Append Completion"="yes" or delete the value.

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AutoComplete]
"Append Completion"="no"
